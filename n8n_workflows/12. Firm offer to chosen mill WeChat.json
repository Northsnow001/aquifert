      "id": "a12-get-suppliers",
      "name": "Get Suppliers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [64, 80],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "G2UyglLcLdj8jIvK",
          "name": "Kayode Daniel"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const hookItem = $('Webhook').first().json;\nconst hook = hookItem.body && typeof hookItem.body === 'object' ? hookItem.body : hookItem;\n\nconst millMessage = String(hook.millMessage || '').trim();\nconst supplierUnitPrice = Number(hook.supplierUnitPrice);\nif (!millMessage || !(supplierUnitPrice > 0)) {\n  return [{ json: { skip: true, reason: 'missing_mill_message_or_price' } }];\n}\n\nconst wantOpen = String(hook.wechatOpenId || '').trim();\nconst wantName = String(hook.supplierName || '').trim().toLowerCase();\nconst rows = $input.all().map((item) => item.json);\n\nfunction oid(row) {\n  return String(row['WeChat ID'] || row.wechatOpenId || '').trim();\n}\nfunction company(row) {\n  return String(row['Company Name'] || row.supplierName || '').trim().toLowerCase();\n}\n\nlet row = wantOpen ? rows.find((r) => oid(r) === wantOpen) : null;\nif (!row && wantName) {\n  row = rows.find((r) => {\n    const n = company(r);\n    return n && (n === wantName || n.includes(wantName) || wantName.includes(n));\n  });\n}\n\nconst openid = wantOpen || (row ? oid(row) : '');\nif (!openid) {\n  return [{ json: { skip: true, reason: 'no_wechat_id', supplierName: hook.supplierName || '' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    openid,\n    millMessage,\n    requestId: hook.requestId || '',\n    supplierName: hook.supplierName || (row ? row['Company Name'] : ''),\n    supplierUnitPrice,\n  },\n}];"
      },
