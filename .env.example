NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required so sign-up can email a code and text a code for the same account.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (Admin → Data streams). Leave empty to send nothing.
# Set this on the production host only. NEXT_PUBLIC_GA_DEBUG=1 also sends from a local dev server into DebugView.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG=

# Lets the admin dashboard read live visitors. The property id is the number in the Analytics URL after "p".
# The email and private key come from a Google Cloud service account with the Analytics Data API enabled.
# Add that email as a Viewer under Admin → Property access management.
GA4_PROPERTY_ID=564333880
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# n8n → POST /api/firm-order/pdf (header x-firm-order-secret or Bearer)
FIRM_ORDER_PDF_SECRET=

# n8n desk HITL (WF8 shortlist + WhatsApp poll). Falls back to FIRM_ORDER_PDF_SECRET if unset.
# Header: x-desk-hitl-secret or Authorization: Bearer
DESK_HITL_SECRET=

# Desk alerts (conversation, RFQ, supplier quote, shortlist, indication, FO). Comma-separated extras merge with DEFAULT_ADMINS in code.
DESK_ALERT_EMAIL=kaytoba49@gmail.com
AQUIFERT_ADMIN_EMAILS=kaytoba49@gmail.com,deji.ogunmola09@gmail.com,mol@aquifert.com,campbell@aquifert.com,noreply@aquifert.com

# n8n WF9 — POST JSON when Matt clicks Send indication to buyer
DESK_INDICATION_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/response_from_matt

# n8n WF11 Gmail trigger should POST { from, subject, text } (or a proforma JSON) to /api/desk/pi-draft
# n8n WF12 — fallback WhatsApp when Matt emails the firm offer. body.buyerPhone + body.whatsappBody.
DESK_FIRM_OFFER_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/notify_buyer_on_firm_offer
# n8n WF14 — fallback WeChat to the chosen supplier. Price is supplier unit only.
DESK_FIRM_OFFER_MILL_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/notify_mill_on_firm_offer
# n8n WF13 — fallback for Matt's negotiation / packing WhatsApps. body.buyerPhone + body.whatsappBody.
DESK_BUYER_WHATSAPP_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/desk_to_buyer

# Stripe subscriptions for AQ Analytics and AQ Zero.
# Secret key: Stripe Dashboard → Developers → API keys. Webhook secret: Developers → Webhooks,
# endpoint https://www.aquifert.com/api/stripe/webhook, events checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted.
# Each price id is a recurring Price (price_...) for that plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANALYTICS=
STRIPE_PRICE_ZERO_SPROUT=
STRIPE_PRICE_ZERO_HARVEST=
STRIPE_PRICE_ZERO_SCALE=

# Supplier pack (PO, purchase contract, documentary instructions) is emailed in-app. WF10 is not used.

# WeChat Official Account (server only).
# App ID + secret: send (access token, QR, customer messages). Cached in trade_settings.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Token: receive. Same string as 开发 → 基本配置 → Token in mp.weixin.qq.com.
# Server URL: https://www.aquifert.com/api/trade/wechat
WECHAT_TOKEN=
# Industry template for RFQ fan-out (workflow 7). Falls back to a customer-service text if this send fails.
WECHAT_RFQ_TEMPLATE_ID=

# Twilio WhatsApp (workflow 1b / 6). From number is the Aquifert desk line.
# Inbound webhook: https://www.aquifert.com/api/trade/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+447427829952
WHATSAPP_DESK_E164=+447427829952
