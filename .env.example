NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required so sign-up can email a code and text a code for the same account.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n → POST /api/firm-order/pdf (header x-firm-order-secret or Bearer)
FIRM_ORDER_PDF_SECRET=

# n8n desk HITL (WF8 shortlist + WhatsApp poll). Falls back to FIRM_ORDER_PDF_SECRET if unset.
# Header: x-desk-hitl-secret or Authorization: Bearer
DESK_HITL_SECRET=

# n8n WF9 — POST JSON when Matt clicks Send indication to buyer
DESK_INDICATION_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/response_from_matt

# n8n WF10 — POST JSON when Matt clicks Issue supplier documents (after buyer payment)
DESK_SUPPLIER_PACK_WEBHOOK_URL=https://northsnow.app.n8n.cloud/webhook/supplier_documents
