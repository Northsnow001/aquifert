# ── Demo / client review ────────────────────────────────────────
# In-memory demo personas when DEMO_MODE=true (or no DATABASE_URL in dev).
# Lead modal / Request Access remain hidden in the UI separately.
DEMO_MODE=false
VITE_DEMO_MODE=false

# ── Backend ─────────────────────────────────────────────────────
APP_ID=aquifert-local
APP_SECRET=               # Random secret for app session cookies (JWT)

# ── Supabase (Auth + Postgres) ──────────────────────────────────
# Project Settings → API
SUPABASE_URL=             # https://[ref].supabase.co
SUPABASE_ANON_KEY=        # anon/public key
SUPABASE_SERVICE_ROLE_KEY=# service_role (server only — never expose to Vite)

# Same values for the browser client (Vite only exposes VITE_* )
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project Settings → Database → Connection string (URI)
# Use Transaction pooler (port 6543). Dedicated pooler may use db.[ref].supabase.co:6543.
DATABASE_URL=

# Auth UX (app): register → email OTP → set password → onboarding
# In Supabase Dashboard → Authentication → Email Templates → Magic Link:
# paste db/email-templates/magic-link-otp.html (uses {{ .Token }}, not ConfirmationURL).
# Authentication → Providers → Email: enable Email.
# Authentication → URL Configuration: add http://localhost:3000/** and your Vercel URL.

# ── Legacy Kimi OAuth (optional; unused when Supabase Auth is configured) ──
VITE_KIMI_AUTH_URL=
VITE_APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=           # Optional: unionId that gets role admin on first sync (e.g. supabase:<uuid>)

# ── Legacy password login API (identity.login) ───────────────────
# Supabase Auth does not need this. Leave unset unless you re-enable old OTP/password paths.
# LOGIN_ENABLED=true
